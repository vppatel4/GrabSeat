# Copy this file to .env before running docker compose.
# Windows PowerShell:  copy .env.example .env
# macOS / Linux:       cp .env.example .env
#
# Nothing here is a real secret — these are the local Docker defaults.
# In a real deployment you would replace them with managed connection strings.

# --- Postgres (durable source of truth: confirmed bookings + metadata) ---
POSTGRES_USER=grabseat
POSTGRES_PASSWORD=grabseat_local_pw
POSTGRES_DB=grabseat
POSTGRES_PORT=5432

# Connection string the backend uses to reach Postgres inside the compose network.
DATABASE_URL=postgres://grabseat:grabseat_local_pw@postgres:5432/grabseat?sslmode=disable

# --- Redis (ephemeral hold locks + pub/sub broadcast) ---
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- Backend ---
BACKEND_PORT=8080
# How long a seat stays held before it auto-releases (seconds).
# Kept short here so the "let a hold expire" demo is quick to watch.
HOLD_TTL_SECONDS=120
# Requests allowed per session per minute on the hold/confirm endpoints.
RATE_LIMIT_PER_MINUTE=60
# CORS origin the browser app is served from.
ALLOWED_ORIGIN=http://localhost:3000
# Trace exporter: stdout | none  (stdout prints real OpenTelemetry spans to the logs)
OTEL_TRACES_EXPORTER=stdout
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Frontend ---
FRONTEND_PORT=3000
# Public URLs the browser uses to reach the backend (host-side, not compose-internal).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
